SOURCE = "fn(use(x, y)) {
  IF (x > 0) {
    result = x + y
  } ELSE {
    result = 0
  }
  result
}

print result(add(5, 3))"

# Create comprehensive lookup tables
KEYWORDS = box()
pack("print") -> KEYWORDS
pack("IF") -> KEYWORDS
pack("ELSE") -> KEYWORDS
pack("WHILE") -> KEYWORDS
pack("fn") -> KEYWORDS
pack("test") -> KEYWORDS
pack("result") -> KEYWORDS
pack("rewire") -> KEYWORDS

BUILTINS = box()
pack("box") -> BUILTINS
pack("pack") -> BUILTINS
pack("unpack") -> BUILTINS
pack("count") -> BUILTINS
pack("string") -> BUILTINS
pack("read") -> BUILTINS
pack("write") -> BUILTINS
pack("fission") -> BUILTINS
pack("fusion") -> BUILTINS
pack("contains") -> BUILTINS
pack("use") -> BUILTINS

OPERATORS = box()
pack("+") -> OPERATORS
pack("-") -> OPERATORS
pack("*") -> OPERATORS
pack("/") -> OPERATORS
pack("%") -> OPERATORS
pack("==") -> OPERATORS
pack("!=") -> OPERATORS
pack("<") -> OPERATORS
pack(">") -> OPERATORS
pack("<=") -> OPERATORS
pack(">=") -> OPERATORS
pack("|<") -> OPERATORS
pack("|>") -> OPERATORS
pack("!") -> OPERATORS
pack("=") -> OPERATORS
pack("->") -> OPERATORS
pack("<-") -> OPERATORS

PUNCTUATION = box()
pack("(") -> PUNCTUATION
pack(")") -> PUNCTUATION
pack("{") -> PUNCTUATION
pack("}") -> PUNCTUATION
pack("[") -> PUNCTUATION
pack("]") -> PUNCTUATION
pack(",") -> PUNCTUATION
pack(";") -> PUNCTUATION
pack(":") -> PUNCTUATION
pack(".") -> PUNCTUATION
pack("?") -> PUNCTUATION
pack("\"") -> PUNCTUATION
pack("'") -> PUNCTUATION
pack("`") -> PUNCTUATION

LITERALS = box()
pack("TRUE") -> LITERALS
pack("FALSE") -> LITERALS
pack("None") -> LITERALS

delims = box()
pack(" ") -> delims
pack("\n") -> delims
mut_1 = fission(delims) <- SOURCE

print mut_1

t = count(mut_1)
i = 0
TOKENS = box()
TYPES = box()

WHILE (i < t) {
    z = unpack(i) <- mut_1
    i = i + 1
    IF (contains(KEYWORDS, z)) {
      pack("KW") -> TYPES
    } ELSE {
      IF (contains(BUILTINS, z)) {
        pack("BUILTIN") -> TYPES
      } ELSE {
        IF (contains(OPERATORS, z)) {
          pack("OP") -> TYPES
        } ELSE {
          IF (contains(PUNCTUATION, z)) {
            pack("PUNC") -> TYPES
          } ELSE {
            IF (contains(LITERALS, z)) {
              pack("LIT") -> TYPES
            } ELSE {
        full_value = fission("") <- z
        inner_count = count(full_value)
        g = 0
        type_box = box()
        WHILE (g < inner_count) {
          single_value = unpack(g) <- full_value
          g = g + 1
          type = get_char_category(single_value)
          pack(type) -> type_box
        }
        
        # Now type_box is fully populated, do the comparison
        IF (inner_count > 1) {
          type_1 = unpack(0) <- type_box
          type_2 = unpack(inner_count - 1) <- type_box
          IF (type_1 == type_2) {
            IF (type_1 == "alpha") {
              pack("ID") -> TYPES
            } ELSE {
              IF (type_1 == "digit") {
                pack("NUM") -> TYPES
              } ELSE {
                pack("OP") -> TYPES
              }
            }
          } ELSE {
            pack("ID") -> TYPES
          }
        } ELSE {
          type = unpack(0) <- type_box
          IF (type == "alpha") {
            pack("ID") -> TYPES
          } ELSE {
            IF (type == "digit") {
              pack("NUM") -> TYPES
            } ELSE {
              pack("OP") -> TYPES
            }
          }
        }
      }
      }
      }
      }
    }
    print TOKENS
    print TYPES
}