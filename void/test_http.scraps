# HTTP tests (requires network). Uses example.com
print "=== HTTP Tests ==="
resp = http_get("https://example.com")
status = unpack(0) <- resp
headers = unpack(1) <- resp
body = unpack(2) <- resp
print "status: " + status
print "headers count: " + count(headers)
print "body prefix: " + substring(body, 0, 60)

