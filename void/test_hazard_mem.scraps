# Memory hazards demo for mem_load/mem_store/mem_cmpxchg

print "=== MEM_LOAD invalid ptr ==="
mem_load("notint", 4)

print "=== MEM_LOAD invalid width ==="
mem_load(0, 3)

print "=== MEM_STORE value out of range for width 1 ==="
mem_store(0, 300, 1)

print "=== MEM_CMPXCHG invalid ptr ==="
mem_cmpxchg("bad", 10, 11)

