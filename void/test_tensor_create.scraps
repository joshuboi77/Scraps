# Test file for tensor creation function
# This tests the create_tensor function and basic tensor operations

# Import tensor functions (assuming they're in the same scope for now)
import("tensor")

print "=== Testing Tensor Creation ==="

# Test 1: Create a 2x3 tensor
print "Test 1: Creating 2x3 tensor"
tensor_2x3 = create_tensor(2, 3)

# Verify shape
shape = tensor_shape(tensor_2x3)
rows = unpack(0) <- shape
cols = unpack(1) <- shape
print "Shape: [" + rows + ", " + cols + "]"
test (rows == 2)
test (cols == 3)

# Verify size
size = tensor_size(tensor_2x3)
print "Total elements: " + size
test (size == 6)

# Test 2: Create a 1x1 tensor
print ""
print "Test 2: Creating 1x1 tensor"
tensor_1x1 = create_tensor(1, 1)
size_1x1 = tensor_size(tensor_1x1)
print "1x1 tensor size: " + size_1x1
test (size_1x1 == 1)

# Test 3: Create a 4x2 tensor
print ""
print "Test 3: Creating 4x2 tensor"
tensor_4x2 = create_tensor(4, 2)
shape_4x2 = tensor_shape(tensor_4x2)
rows_4x2 = unpack(0) <- shape_4x2
cols_4x2 = unpack(1) <- shape_4x2
print "4x2 tensor shape: [" + rows_4x2 + ", " + cols_4x2 + "]"
test (rows_4x2 == 4)
test (cols_4x2 == 2)

# Test 4: Test tensor_get function (should return 0.0 for initialized tensor)
print ""
print "Test 4: Testing tensor_get function"
element_0_0 = tensor_get(tensor_2x3, 0, 0)
element_1_2 = tensor_get(tensor_2x3, 1, 2)
print "Element at (0,0): " + element_0_0
print "Element at (1,2): " + element_1_2
test (element_0_0 == 0.0)
test (element_1_2 == 0.0)

# Test 5: Display tensor
print ""
print "Test 5: Displaying 2x3 tensor"
tensor_print(tensor_2x3)

print ""
print "=== All tensor creation tests passed! ✅ ==="
