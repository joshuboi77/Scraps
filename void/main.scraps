# Scraps Compiler Main
# Modular compiler that uses lexer and codegen modules

SOURCE = "x = 42 + 17
y = x * 2
print y"


# =============================================================================
# MODULE LOADING
# =============================================================================

# Load and import lexer module
import("lex") <- "lexer"
print "Lexer module loaded"

# Load and import codegen module  
import("codegen")
print "Codegen module loaded"

# =============================================================================
# COMPILER FUNCTIONS
# =============================================================================

# Compile a Scraps source file to assembly
fn(use(lex)) {
  result(lex)
} -> lexer

print result(lexer)

