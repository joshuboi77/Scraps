# UDP helpers without sending traffic
print "=== UDP Helper Tests ==="

fn(use(label, value)) {
  b = box()
  pack(label) -> b
  pack(value) -> b
  b
} -> pair

print pair("224.0.0.1 multicast?", udp_is_multicast("224.0.0.1"))
print pair("239.255.255.250 multicast?", udp_is_multicast("239.255.255.250"))
print pair("255.255.255.255 broadcast?", udp_is_broadcast("255.255.255.255"))
print pair("127.0.0.1 broadcast?", udp_is_broadcast("127.0.0.1"))
