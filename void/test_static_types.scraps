# Static typing & rewire ceremony tests

print "=== Static Types & Rewire ==="

# Simple declarations lock types
x = 1
x = int(2.9)

s = str(5)
print s

# Typed box constructors
ib = int_box()
sb = str_box()

pack(1, 2, 3) -> ib
pack("a", "b") -> sb
print ib
print sb

# Rewire ceremony: change type of y from Str to Int, then back to Str
y = "hello"
print y
rewire y {
  y = 123
} -> y
print y

rewire y {
  y = "world"
} -> y
print y

# Another rewire demo with z
z = 10
rewire z {
  z = "now string"
} -> z
print z

print "=== Done ==="

