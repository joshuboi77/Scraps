# Tests for JSON, Base64, and URL encoding/decoding

print "=== JSON / Base64 / URL Encoding Tests ==="

# JSON encode/decode round-trip
data = box()
pack("name", "Alice") -> data
pack("age", 30) -> data
json_s = json_encode(data)
print json_s
decoded = json_decode(json_s)
print decoded

# Base64
msg = "hello world"
b64 = base64_encode(msg)
print b64
decoded_b64 = base64_decode(b64)
print decoded_b64

# URL
u = "Hello, World! 1+2=3"
ue = url_encode(u)
print ue
ud = url_decode(ue)
print ud

