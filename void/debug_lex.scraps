# Debug lexer step by step
import("lexer")

# Test source
test_source = "x = 42 + 17"

print "Source:"
print test_source
print "Source type:"
print type(test_source)

# Try to call lex
print "Calling lex..."
lex_result = lex(test_source)
print "Lex result type:"
print type(lex_result)

# Try to unpack
print "Unpacking tokens..."
tokens = unpack("tokens") <- lex_result
print "Tokens type:"
print type(tokens)
print "Tokens count:"
print count(tokens)
