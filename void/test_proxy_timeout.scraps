# Proxy and Timeout manager tests (prints and toggles safe state)
print "=== Proxy Manager ==="
proxy_clear_all()
print proxy_stats()
proxy_add_bypass("localhost")
print proxy_get_bypass_list()
print proxy_get_info("http")

print "=== Timeout Manager ==="
timeout_clear()
timeout_set_global("tcp", 1000, 2000, 2000)
timeout_set_specific("tcp", "example.com", 443, 1500, 2500, 2500)
print timeout_get_info("tcp")
print timeout_summary()
