# Scraps Lexer Module
# Provides tokenization functionality for the Scraps compiler

# =============================================================================
# LEXER MODULE EXPORTS
# =============================================================================

# Create comprehensive lookup tables
KEYWORDS = box()
pack("print") -> KEYWORDS
pack("IF") -> KEYWORDS
pack("ELSE") -> KEYWORDS
pack("WHILE") -> KEYWORDS
pack("fn") -> KEYWORDS
pack("test") -> KEYWORDS
pack("result") -> KEYWORDS
pack("rewire") -> KEYWORDS
pack("import") -> KEYWORDS
pack("source") -> KEYWORDS

BUILTINS = box()
pack("box") -> BUILTINS
pack("pack") -> BUILTINS
pack("unpack") -> BUILTINS
pack("count") -> BUILTINS
pack("string") -> BUILTINS
pack("read") -> BUILTINS
pack("write") -> BUILTINS
pack("fission") -> BUILTINS
pack("fusion") -> BUILTINS
pack("contains") -> BUILTINS
pack("use") -> BUILTINS

OPERATORS = box()
pack("+") -> OPERATORS
pack("-") -> OPERATORS
pack("*") -> OPERATORS
pack("/") -> OPERATORS
pack("%") -> OPERATORS
pack("mod") -> OPERATORS
pack("==") -> OPERATORS
pack("!=") -> OPERATORS
pack("<") -> OPERATORS
pack(">") -> OPERATORS
pack("<=") -> OPERATORS
pack(">=") -> OPERATORS
pack("|<") -> OPERATORS
pack("|>") -> OPERATORS
pack("!") -> OPERATORS
pack("=") -> OPERATORS
pack("->") -> OPERATORS
pack("<-") -> OPERATORS
pack(":") -> OPERATORS

PUNCTUATION = box()
pack("(") -> PUNCTUATION
pack(")") -> PUNCTUATION
pack("{") -> PUNCTUATION
pack("}") -> PUNCTUATION
pack("[") -> PUNCTUATION
pack("]") -> PUNCTUATION
pack(",") -> PUNCTUATION
pack(";") -> PUNCTUATION
pack(".") -> PUNCTUATION
pack("?") -> PUNCTUATION

LITERALS = box()
pack("TRUE") -> LITERALS
pack("FALSE") -> LITERALS
pack("None") -> LITERALS

# =============================================================================
# LEXER FUNCTIONS
# =============================================================================

# Main lexer function - tokenizes source code
fn(use(SOURCE)) {
  delim = box()
  pack("\n") -> delim
  pack(" ") -> delim

  mut_1 = fission(delim) <- SOURCE

  token_count = count(mut_1)
  i = 0

  token_box = box()

  WHILE (i < token_count) {
    token = unpack(i) <- mut_1
    i = i + 1
    
    IF (contains(KEYWORDS, token)) {
      print "KW" + " " + token
    } ELSE {
      IF (contains(BUILTINS, token)) {
        print "BI" + " " + token
      } ELSE {
        IF (contains(OPERATORS, token)) {
          print "OP" + " " + token
        } ELSE {
          IF (contains(PUNCTUATION, token)) {
            print "PN" + " " token
          } ELSE {
            IF (contains(LITERALS, token)) {
              print "LI" + " " + token
            } ELSE {
              mut_2 = fission("") <- token
              char_count = count(mut_2)

              IF (char_count == 1) {
                char = unpack(0) <- mut_2
                type = get_char_category(char)
                IF (type == "alpha") {
                  print "ID" + " " + token
                } ELSE {
                  print "NUM" + " " + token
                }
              } ELSE {
                char_1 = unpack(0) <- mut_2
                char_2 = unpack(char_count - 1) <- mut_2
                char_type_1 = get_char_category(char_1)
                char_type_2 = get_char_category(char_2)
                IF (char_type_1 == char_type_2) {
                  IF (char_type_1 == "alpha") {
                    print "ID" + " " + token
                  } ELSE {
                    print "NUM" + " " + token
                  }
                } ELSE {
                  print "ID" + " " + token
                }
              }
            }
          }
        }
      }
    }

    pack(token) -> token_box
    token_box
  }
} -> lex