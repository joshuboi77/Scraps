# Math extras and vector ops
print "=== Math Extras ==="
print deg(3.141592653589793)
print rad(180)
print sin_deg(30)
print cos_deg(60)
print tan_deg(45)
print atan2(1, 1)
print hypot(3, 4)
print trunc(3.9)
print frac(3.25)
print mod(7, 3)
print div(7, 3)
print divmod(7, 3)
print pow_int(2, 8)
print nearly_equal(1.0001, 1.0002, 0.001)
print clamp(10, 0, 5)

print "=== Vector ==="
v = box()
pack(3, 4) -> v
print length(v)
u = box()
pack(1, 2) -> u
print dot(u, v)
print sum(u)
print mean(v)
print linspace(0, 1, 5)
print range(0, 5, 2)

