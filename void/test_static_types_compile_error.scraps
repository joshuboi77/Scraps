# This file intentionally triggers compile-time type errors

print "=== Compile-time type errors ==="

# 1) Simple reassignment to different type (no rewire): should fail at compile time
x = 1
x = "oops"  # Expect compile-time TYPE error

# 2) Packing wrong element types into a str_box
sb = str_box()
pack(1) -> sb  # Expect compile-time TYPE error for BoxStr vs Int element

# 3) Using pack on a scalar variable
i = 42
pack("x") -> i  # Expect compile-time TYPE error (scalar used as Box)

